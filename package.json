{
	"name": "humanity-protocol",
	"version": "1.0.0",
	"private": true,
	"main": "main.js",
	"scripts": {
		"start": "electron .",
		"dist": "electron-builder",
		"dist:dir": "electron-builder --dir",
		"build:mac-app": "rm -rf dist && electron-builder --dir --mac && rm -f dist/builder-debug.yml dist/builder-effective-config.yaml dist/latest-mac.yml",
		"dist:mac": "electron-builder --mac",
		"dist:win": "electron-builder --win"
	},
	"devDependencies": {
		"electron": "^42.0.1",
		"electron-builder": "^24.13.3"
	},
	"build": {
		"appId": "com.sasidatr.humanityprotocol",
		"productName": "Humanity Protocol",
		"files": [
			"main.js",
			"index.html",
			"package.json",
			"src/**/*"
		],
		"directories": {
			"buildResources": "build"
		},
		"mac": {
			"category": "public.app-category.games",
			"target": [
				"dmg",
				"zip"
			]
		},
		"win": {
			"target": [
				"nsis",
				"zip"
			]
		},
		"linux": {
			"category": "Game",
			"target": [
				"AppImage",
				"zip"
			]
		}
	}
}
